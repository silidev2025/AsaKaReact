# Settings read when the app starts or builds. Vite only shares variables that
# start with VITE_ with the app (as import.meta.env.VITE_...), and index.html can
# use them as %VITE_...%.
#
# To override a value on your own computer without committing it, put it in
# .env.local (that file is ignored by git).

# App name and text shown in the browser tab, link previews and the install prompt.
VITE_APP_NAME=YourRoute
VITE_APP_DESCRIPTION=YourRoute is an offline website built to help CITU students find their rooms across the Cebu Institute of Technology - University campus.
VITE_APP_SHARE_TITLE=YourRoute utility for finding rooms around CITU
# Color of the browser bar on phones. Keep the quotes: without them the #
# would start a comment and the value would be empty.
VITE_THEME_COLOR="#a30e00"

# MapTiler key for the map tiles (https://cloud.maptiler.com/account/keys/).
# This key is sent to every visitor's browser, so it is not a secret. MapTiler
# only accepts it from the sites listed in the key's settings: add your site
# and http://localhost:5173 there, or put your own key in .env.local.
VITE_MAPTILER_KEY=B6m4DQknxd9wZ70DnDV4
